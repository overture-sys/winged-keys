{
  "SDKVersion": 1,
  "Name": "Winged Keys",
  "Author": "overture-sys",
  "Description": "Winged Keys (beta) for Hermes Agent: status, usage, ask and stop keys for your self-hosted Hermes. Not affiliated with Nous Research.",
  "Category": "Winged Keys",
  "CategoryIcon": "static/category.png",
  "Icon": "static/plugin.png",
  "Version": "0.11.0",
  "CodePathWin": "plugin/index.js",
  "CodePathMac": "plugin/index.js",
  "URL": "",
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinimumVersion": "3.10.188.226"
  },
  "Nodejs": {
    "Version": "20"
  },
  "Actions": [
    {
      "UUID": "com.wingedkeys.hermes.status",
      "Name": "Status",
      "Tooltip": "Shows whether Hermes is running (green), needs a key (amber) or is off (red).",
      "Icon": "static/status.png",
      "DisableAutomaticStates": true,
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "Controllers": [
        "Keypad",
        "Information",
        "Knob"
      ],
      "PropertyInspectorPath": "propertyInspector/index.html",
      "States": [
        {
          "Image": "static/key-idle.png",
          "TitleAlignment": "bottom",
          "FontSize": "9"
        }
      ]
    },
    {
      "UUID": "com.wingedkeys.hermes.ask",
      "Name": "Ask",
      "Tooltip": "Sends a preset prompt to Hermes and saves the reply to a file.",
      "Icon": "static/ask.png",
      "DisableAutomaticStates": true,
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "Controllers": [
        "Keypad",
        "Information",
        "Knob"
      ],
      "PropertyInspectorPath": "propertyInspector/index.html",
      "States": [
        {
          "Image": "static/key-idle.png",
          "TitleAlignment": "bottom",
          "FontSize": "9"
        }
      ]
    },
    {
      "UUID": "com.wingedkeys.hermes.approve",
      "Name": "Approve",
      "Tooltip": "Shows the request an Ask run is waiting on and approves it once when you press it.",
      "Icon": "static/approve.png",
      "DisableAutomaticStates": true,
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "PropertyInspectorPath": "propertyInspector/index.html",
